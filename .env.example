# Optional. Backend reads the process environment; export these values in your shell.
SENTINEL_DB=.sentinel/cases.db
OLLAMA_URL=http://127.0.0.1:11434
# Leave empty for deterministic-only mode; set to a locally installed Ollama model.
OLLAMA_MODEL=
# Explicitly authorize a dedicated folder. Empty disables background source access.
# Only direct ordinary .jsonl files are read; no recursive or whole-computer scans.
SENTINEL_EVIDENCE_WORKSPACE=
# Seconds between scans (1-300). Use a single backend worker for monitoring.
SENTINEL_MONITOR_INTERVAL=5
